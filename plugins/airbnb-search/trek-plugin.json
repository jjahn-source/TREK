{
  "id": "airbnb-search",
  "name": "Airbnb Search",
  "version": "1.3.0",
  "apiVersion": 1,
  "type": "trip-page",
  "trek": ">=3.2.0 <4.0.0",
  "author": "John Jahn",
  "description": "Search Airbnb stays for your trip dates and add listings to the trip as places.",
  "icon": "BedDouble",
  "license": "MIT",
  "homepage": "https://github.com/jjahn-source/TREK",
  "nativeModules": false,
  "permissions": [
    "http:outbound:www.airbnb.com",
    "http:outbound:*.muscache.com",
    "http:outbound:nominatim.openstreetmap.org",
    "db:read:trips",
    "db:write:places",
    "db:meta",
    "hook:place-detail-provider"
  ],
  "egress": ["www.airbnb.com", "*.muscache.com", "nominatim.openstreetmap.org"]
}
